{
  "name": "g3-swp391-2hand-ev-battery-trading",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "prepush": "echo 'Checking build before push...' && pnpm build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,json,css,scss,yml,yaml}\"",
    "check-types": "turbo run check-types",
    "test:k6": "k6 run k6/api-load.js",
    "test:k6:stress": "k6 run k6/api-stress.js",
    "test:k6:spike": "k6 run k6/api-spike.js",
    "test:k6:soak": "k6 run k6/api-soak.js",
    "test:k6:with-api": "node scripts/run-k6-with-api.cjs",
    "test:k6:stress:with-api": "node scripts/run-k6-with-api.cjs api-stress.js",
    "test:k6:spike:with-api": "node scripts/run-k6-with-api.cjs api-spike.js",
    "test:k6:soak:with-api": "node scripts/run-k6-with-api.cjs api-soak.js",
    "test:k6:docker": "docker run --rm -i -v \"%cd%\\k6:/scripts\" -e BASE_URL=http://host.docker.internal:8000 grafana/k6 run /scripts/api-load.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.0.1",
    "recharts": "^3.2.1"
  }
}
